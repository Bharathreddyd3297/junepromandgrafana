      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"demo\", job=\"podinfo\", path!~\"/metrics|/healthz|/readyz\"}[1m])))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ]
    },
